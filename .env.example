# ==============================================================================
# AESTHETIC DENTAL CLINIC — ENVIRONMENT CONFIGURATION TEMPLATE
# Copy to .env for local development. Configure in Vercel / Cloud Run secrets.
# ==============================================================================

# Server Configuration
PORT=3000
NODE_ENV=development

# Supabase (External Database & Auth)
# Public Client Variables (Safe for Browser)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Server-Only Supabase Variables (NEVER expose to frontend)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Gemini AI API Key (Auto-configured on Google AI Studio; required on Vercel)
GEMINI_API_KEY=your-gemini-api-key

# Razorpay Test / Production Credentials (Server-side signature verification)
RAZORPAY_KEY_ID=your-razorpay-key-id
RAZORPAY_KEY_SECRET=your-razorpay-key-secret
RAZORPAY_WEBHOOK_SECRET=your-razorpay-webhook-secret

# Clinic Details
CLINIC_WHATSAPP_NUMBER=+918049128800
